#!/bin/bash
{#
The shebang must be the very first line of the rendered script. A Jinja comment
renders to an empty line, so keeping the copyright header above it would leave
this 0750 file starting with a blank line, which the kernel rejects with ENOEXEC
when the script is executed directly (systemd, Ansible, cron). Interactive
shells hide the problem by falling back to /bin/sh.

SPDX-FileCopyrightText: 2023 Slavi Pantaleev

SPDX-License-Identifier: AGPL-3.0-or-later
#}
{#
Runs mongosh inside the (running) MongoDB container. The first `--eval` authenticates as the superuser
with the credentials from the container's own environment (see the `env` file), so that they do not appear on any command line.
It ends with `undefined`, so that its result is not printed.
`--shell` keeps mongosh interactive afterwards. Further arguments are passed on to mongosh.
mongosh's home (logs, history) is pointed at /tmp in the container, so that nothing ends up in the data directory.
A TTY is only requested when there is one.
#}
docker_exec_args=(-i)
if [ -t 0 ]; then
  docker_exec_args+=(-t)
fi

exec {{ devture_systemd_docker_base_host_command_docker }} exec "${docker_exec_args[@]}" --env HOME=/tmp {{ mongodb_identifier }} \
  mongosh --quiet \
  --eval 'db.getSiblingDB("admin").auth(process.env.MONGO_INITDB_ROOT_USERNAME, process.env.MONGO_INITDB_ROOT_PASSWORD); undefined' \
  --shell \
  admin \
  "$@"
