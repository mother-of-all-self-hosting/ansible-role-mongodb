#!/bin/bash
{#
The shebang must be the very first line of the rendered script. A Jinja comment
renders to an empty line, so keeping the copyright header above it would leave
this 0750 file starting with a blank line, which the kernel rejects with ENOEXEC
when the script is executed directly (systemd, Ansible, cron). Interactive
shells hide the problem by falling back to /bin/sh.

SPDX-FileCopyrightText: 2023 Slavi Pantaleev

SPDX-License-Identifier: AGPL-3.0-or-later
#}
if [ $# -ne 1 ]; then
  echo "Usage: "$0" <directory_path>"
  echo "A latest-dump.archive.gz file (a gzipped mongodump archive) will be dumped to the specified directory"
  exit 1
fi

directory_path=$1

if [ ! -d "$directory_path" ]; then
  echo "$directory_path does not exist."
  exit 1
fi

dump_path="$directory_path/latest-dump.archive.gz"

# Runs in the (running) MongoDB container, as the superuser that the container's environment defines,
# and streams the archive out. The password goes to mongodump in a config file (as a single-quoted YAML string),
# so that it does not appear on any command line.
read -r -d '' dump_script <<'EOF'
password=$MONGO_INITDB_ROOT_PASSWORD
exec mongodump \
  --config=<(printf "password: '%s'\n" "${password//\'/\'\'}") \
  --username="$MONGO_INITDB_ROOT_USERNAME" \
  --authenticationDatabase=admin \
  --quiet \
  --gzip \
  --archive
EOF

# The dump goes to a temporary file first, so that a failed dump neither leaves a truncated archive behind
# (which could be mistaken for a good one) nor destroys the previous dump.
{{ devture_systemd_docker_base_host_command_docker }} exec {{ mongodb_identifier }} bash -c "$dump_script" > "$dump_path.partial"
status=$?

if [ $status -ne 0 ]; then
  rm -f "$dump_path.partial"
  echo "Dumping failed (exit code $status)." >&2
  exit $status
fi

mv "$dump_path.partial" "$dump_path"
